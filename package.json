{
  "name": "dokuems-grapesjs-designer-poc",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Isolated DokuEMS visual document designer proof of concept using GrapesJS Core and Playwright PDF preview.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n WEB,PDF -c cyan,magenta \"vite --host 127.0.0.1 --port 5181 --strictPort\" \"node server/pdf-server.mjs\"",
    "dev:web": "vite --host 127.0.0.1 --port 5181 --strictPort",
    "pdf-server": "node server/pdf-server.mjs",
    "install:browser": "playwright install chromium",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4181 --strictPort",
    "start": "node server/pdf-server.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^4.21.2",
    "grapesjs": "^0.23.6",
    "playwright": "^1.56.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "typescript": "~5.8.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
